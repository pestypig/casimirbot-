{
  "action_kind": "execute_reactive_program",
  "program_schema": "helix.minecraft.reactive_program.v1",
  "program_id": "program:guardian-track-move-feed-a0",
  "ruleset": "survival_tas",
  "execution_plane": "player_embodiment",
  "scheduler_engine": "native_fabric_concurrent",
  "max_total_ticks": 180,
  "completion_policy": {
    "mode": "all_required",
    "cancel_remaining_on_settle": true
  },
  "mutation_scope": {
    "world_mutation_allowed": false,
    "max_block_mutations": 0,
    "max_inventory_transfers": 0,
    "allowed_block_ids": [],
    "allowed_regions": [],
    "combat_allowed": false
  },
  "lanes": [
    {
      "lane_id": "lane:camera",
      "lane_kind": "camera",
      "priority": 80,
      "required": true,
      "activation": "immediate",
      "resource_ceiling": ["camera"],
      "start_node_id": "node:camera-track",
      "nodes": [
        {
          "node_id": "node:camera-track",
          "node_kind": "action",
          "earliest_tick": 0,
          "timeout_ticks": 120,
          "action": {
            "action_kind": "track_target",
            "target": {
              "target_kind": "entity_type",
              "entity_type_id": "minecraft:cow",
              "selection": "nearest"
            },
            "aim_point": "render_center",
            "max_acquisition_distance": 16,
            "max_duration_ms": 5000,
            "max_turn_degrees_per_tick": 12,
            "max_angular_acceleration_degrees_per_tick_squared": 3,
            "prediction_ticks": 1,
            "deadband_degrees": 0.5,
            "reacquire_ticks": 10,
            "require_line_of_sight": true,
            "stop_below_health": 6
          },
          "on_success": "node:camera-done",
          "on_failure": "node:camera-failed",
          "on_timeout": "node:camera-failed"
        },
        {
          "node_id": "node:camera-done",
          "node_kind": "terminal",
          "terminal_outcome": "succeeded",
          "reason_code": "camera_tracking_complete"
        },
        {
          "node_id": "node:camera-failed",
          "node_kind": "terminal",
          "terminal_outcome": "failed",
          "reason_code": "camera_tracking_failed"
        }
      ]
    },
    {
      "lane_id": "lane:locomotion",
      "lane_kind": "locomotion",
      "priority": 60,
      "required": true,
      "activation": "immediate",
      "resource_ceiling": ["locomotion"],
      "start_node_id": "node:step",
      "nodes": [
        {
          "node_id": "node:step",
          "node_kind": "action",
          "earliest_tick": 15,
          "timeout_ticks": 40,
          "action": {
            "action_kind": "walk",
            "direction": "forward",
            "duration_ms": 250,
            "sprint": false
          },
          "on_success": "node:step-done",
          "on_failure": "node:step-failed",
          "on_timeout": "node:step-failed"
        },
        {
          "node_id": "node:step-done",
          "node_kind": "terminal",
          "terminal_outcome": "succeeded",
          "reason_code": "bounded_step_complete"
        },
        {
          "node_id": "node:step-failed",
          "node_kind": "terminal",
          "terminal_outcome": "failed",
          "reason_code": "bounded_step_failed"
        }
      ]
    },
    {
      "lane_id": "lane:hand",
      "lane_kind": "hand",
      "priority": 70,
      "required": true,
      "activation": "immediate",
      "resource_ceiling": ["main_hand", "off_hand"],
      "start_node_id": "node:feed-repeat",
      "nodes": [
        {
          "node_id": "node:feed-repeat",
          "node_kind": "repeat",
          "earliest_tick": 15,
          "action": {
            "action_kind": "interact",
            "target": "looked_at_entity",
            "hand": "off_hand",
            "interaction": "interact"
          },
          "max_iterations": 3,
          "timeout_ticks": 60,
          "on_complete": "node:feed-done",
          "on_failure": "node:feed-failed",
          "on_timeout": "node:feed-failed"
        },
        {
          "node_id": "node:feed-done",
          "node_kind": "terminal",
          "terminal_outcome": "succeeded",
          "reason_code": "bounded_feeding_complete"
        },
        {
          "node_id": "node:feed-failed",
          "node_kind": "terminal",
          "terminal_outcome": "failed",
          "reason_code": "bounded_feeding_failed"
        }
      ]
    },
    {
      "lane_id": "lane:safety",
      "lane_kind": "safety",
      "priority": 255,
      "required": false,
      "activation": "interrupt_only",
      "resource_ceiling": ["safety"],
      "start_node_id": "node:safety-stop",
      "nodes": [
        {
          "node_id": "node:safety-stop",
          "node_kind": "terminal",
          "terminal_outcome": "canceled",
          "reason_code": "low_health_interrupt"
        }
      ]
    }
  ],
  "races": [],
  "interrupts": [
    {
      "interrupt_id": "interrupt:low-health",
      "priority": 255,
      "condition": {
        "condition_kind": "health_at_least",
        "health": 6
      },
      "trigger_when": "not_satisfied",
      "debounce_ticks": 1,
      "activate_lane_id": "lane:safety",
      "cancel_lane_ids": ["lane:camera", "lane:locomotion", "lane:hand"],
      "max_activations": 1
    }
  ]
}
