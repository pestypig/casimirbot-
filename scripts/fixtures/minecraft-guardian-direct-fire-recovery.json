{
  "action_kind": "execute_reactive_program",
  "program_schema": "helix.minecraft.reactive_program.v1",
  "program_id": "program:guardian-fire-recovery-water-course",
  "ruleset": "survival_tas",
  "execution_plane": "player_embodiment",
  "scheduler_engine": "native_fabric_concurrent",
  "resident_guardian_coverage": ["fire_recovery"],
  "max_total_ticks": 800,
  "completion_policy": {
    "mode": "all_required",
    "cancel_remaining_on_settle": true
  },
  "mutation_scope": {
    "world_mutation_allowed": false,
    "max_block_mutations": 0,
    "max_inventory_transfers": 0,
    "allowed_block_ids": [],
    "allowed_regions": [],
    "combat_allowed": false
  },
  "lanes": [
    {
      "lane_id": "lane:fire-recovery",
      "lane_kind": "locomotion",
      "priority": 100,
      "required": true,
      "activation": "immediate",
      "resource_ceiling": ["locomotion"],
      "start_node_id": "node:fire-detected",
      "nodes": [
        {
          "node_id": "node:fire-detected",
          "node_kind": "event",
          "earliest_tick": 0,
          "condition": {
            "condition_kind": "in_lava_is",
            "expected": true
          },
          "trigger_when": "satisfied",
          "debounce_ticks": 1,
          "wait_up_to_ticks": 600,
          "on_event": "node:enter-water",
          "on_timeout": "node:fire-recovery-failed"
        },
        {
          "node_id": "node:enter-water",
          "node_kind": "action",
          "earliest_tick": 0,
          "timeout_ticks": 70,
          "action": {
            "action_kind": "walk",
            "direction": "forward",
            "duration_ms": 1400,
            "sprint": true,
            "jump": true
          },
          "on_success": "node:fire-cleared",
          "on_failure": "node:fire-recovery-failed",
          "on_timeout": "node:fire-recovery-failed"
        },
        {
          "node_id": "node:fire-cleared",
          "node_kind": "event",
          "earliest_tick": 0,
          "condition": {
            "condition_kind": "in_lava_is",
            "expected": false
          },
          "trigger_when": "satisfied",
          "debounce_ticks": 2,
          "wait_up_to_ticks": 50,
          "on_event": "node:flames-cleared",
          "on_timeout": "node:fire-recovery-failed"
        },
        {
          "node_id": "node:flames-cleared",
          "node_kind": "event",
          "earliest_tick": 0,
          "condition": {
            "condition_kind": "on_fire_is",
            "expected": false
          },
          "trigger_when": "satisfied",
          "debounce_ticks": 2,
          "wait_up_to_ticks": 50,
          "on_event": "node:fire-recovery-done",
          "on_timeout": "node:fire-recovery-failed"
        },
        {
          "node_id": "node:fire-recovery-done",
          "node_kind": "terminal",
          "terminal_outcome": "succeeded",
          "reason_code": "fire_recovery_verified"
        },
        {
          "node_id": "node:fire-recovery-failed",
          "node_kind": "terminal",
          "terminal_outcome": "failed",
          "reason_code": "fire_recovery_not_verified"
        }
      ]
    },
    {
      "lane_id": "lane:safety",
      "lane_kind": "safety",
      "priority": 255,
      "required": false,
      "activation": "interrupt_only",
      "resource_ceiling": ["safety"],
      "start_node_id": "node:safety-stop",
      "nodes": [
        {
          "node_id": "node:safety-stop",
          "node_kind": "terminal",
          "terminal_outcome": "canceled",
          "reason_code": "health_floor_interrupt"
        }
      ]
    }
  ],
  "races": [],
  "interrupts": [
    {
      "interrupt_id": "interrupt:health-floor",
      "priority": 255,
      "condition": {
        "condition_kind": "health_at_least",
        "health": 8
      },
      "trigger_when": "not_satisfied",
      "debounce_ticks": 1,
      "activate_lane_id": "lane:safety",
      "cancel_lane_ids": ["lane:fire-recovery"],
      "max_activations": 1
    }
  ]
}
