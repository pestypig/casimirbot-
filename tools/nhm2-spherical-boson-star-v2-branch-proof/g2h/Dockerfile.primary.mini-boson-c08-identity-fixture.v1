FROM nhm2-g2h-s4-primary-fixture-builder:v2@sha256:9e94d19f9014938b510e95c776778d164cce120777adfc2d495c1812de5221a1 AS builder

COPY mini_boson_star_primary_grid_v1.hpp /src/mini_boson_star_primary_grid_v1.hpp
COPY mini_boson_star_primary_grid_v1.cpp /src/mini_boson_star_primary_grid_v1.cpp
COPY mini_boson_star_primary_c08_identity_v1.hpp /src/mini_boson_star_primary_c08_identity_v1.hpp
COPY mini_boson_star_primary_c08_identity_v1.cpp /src/mini_boson_star_primary_c08_identity_v1.cpp
COPY mini_boson_star_primary_c08_identity_fixture_v1.cpp /src/mini_boson_star_primary_c08_identity_fixture_v1.cpp

RUN g++ -std=c++20 -O2 -fno-fast-math -fno-common -Wall -Wextra -Werror \
      -o /usr/local/bin/mini-boson-star-primary-c08-identity-fixture-v1 \
      /src/mini_boson_star_primary_grid_v1.cpp \
      /src/mini_boson_star_primary_c08_identity_v1.cpp \
      /src/mini_boson_star_primary_c08_identity_fixture_v1.cpp \
      -lflint-arb -lflint -lgmp -lmpfr

FROM nhm2-g2h-primary-proof:v2@sha256:8334e9777fd7cb9405d8878b243d0196f3e45d9d51d82df159452dcb430159ab

COPY --from=builder /usr/local/bin/mini-boson-star-primary-c08-identity-fixture-v1 \
     /usr/local/bin/mini-boson-star-primary-c08-identity-fixture-v1

ENTRYPOINT ["/usr/local/bin/mini-boson-star-primary-c08-identity-fixture-v1"]
