FROM nhm2-g2h-primary-proof:v3@sha256:5a790295492d607fc9c3ede7a527a86922e09608cce1eaa9af464d33a1617ada

COPY tolman_vii_primary_proof_v3.c /src/tolman_vii_primary_proof_v3.c
COPY tolman_vii_primary_authorization_schema_fixture_v2.c /src/tolman_vii_primary_authorization_schema_fixture_v2.c

RUN gcc -std=c17 -O2 -fno-fast-math -fno-common -Wall -Wextra -Werror \
      -o /usr/local/bin/tolman-vii-primary-authorization-schema-fixture-v2 \
      /src/tolman_vii_primary_authorization_schema_fixture_v2.c \
      -lflint-arb -lflint -lgmp -lmpfr

ENTRYPOINT ["/usr/local/bin/tolman-vii-primary-authorization-schema-fixture-v2"]
