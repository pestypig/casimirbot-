FROM nhm2-g2h-primary-proof-v2:preexecution

COPY tolman_vii_primary_surface_gate.c /src/tolman_vii_primary_surface_gate.c
COPY tolman_vii_primary_proof_v2.c /src/tolman_vii_primary_proof_v2.c
COPY tolman_vii_primary_self_identity_fixture_v1.c /src/tolman_vii_primary_self_identity_fixture_v1.c

RUN gcc -std=c17 -O2 -fno-fast-math -fno-common -Wall -Wextra -Werror \
      -o /usr/local/bin/tolman-vii-primary-self-identity-fixture-v1 \
      /src/tolman_vii_primary_self_identity_fixture_v1.c \
      -lflint-arb -lflint -lgmp -lmpfr

ENTRYPOINT ["/usr/local/bin/tolman-vii-primary-self-identity-fixture-v1"]
