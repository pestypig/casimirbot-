FROM nhm2-g2h-primary-fixture:v1

COPY tolman_vii_primary.c /src/tolman_vii_primary.c
COPY tolman_vii_primary_v3.c /src/tolman_vii_primary_v3.c

RUN gcc -std=c17 -O2 -fno-fast-math -fno-common -Wall -Wextra -Werror \
      -o /usr/local/bin/tolman-vii-primary /src/tolman_vii_primary_v3.c \
      -lflint-arb -lflint -lgmp -lmpfr

ENTRYPOINT ["/usr/local/bin/tolman-vii-primary"]
