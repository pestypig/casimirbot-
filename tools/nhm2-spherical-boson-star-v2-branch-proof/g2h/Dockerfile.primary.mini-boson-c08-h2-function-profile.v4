COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_h2_function_profile_v4.cpp /src/
RUN g++ -std=c++20 -O2 -g -fno-instrument-functions -Wall -Wextra -Werror \
      -c /src/mini_boson_star_primary_c08_h2_function_profile_v4.cpp \
      -o /tmp/h2_function_profile_v4.o && \
    g++ -std=c++20 -O2 -g -finstrument-functions -fno-omit-frame-pointer \
      -fno-fast-math -fno-common -no-pie -Wall -Wextra -Werror \
      -o /usr/local/bin/mini-boson-star-primary-c08-h2-function-profile-v4 \
      /src/mini_boson_star_primary_grid_v1.cpp \
      /src/mini_boson_star_primary_c08_identity_v1.cpp \
      /src/mini_boson_star_primary_c08_margins_v1.cpp \
      /src/mini_boson_star_primary_c08_gevrey_v1.cpp \
      /src/mini_boson_star_primary_c08_convolution_ledger_v1.cpp \
      /src/mini_boson_star_primary_c08_convolution_bivariate_v1.cpp \
      /src/mini_boson_star_primary_c08_convolution_jet_v1.cpp \
      /src/mini_boson_star_primary_c08_origin_models_v1.cpp \
      /src/mini_boson_star_primary_c08_successor_panel_v1.cpp \
      /src/mini_boson_star_primary_c08_scalar_ledger_provider_v1.cpp \
      /src/mini_boson_star_primary_c08_h2_timing_calibration_v1.cpp \
      /tmp/h2_function_profile_v4.o \
      -lflint-arb -lflint -lgmp -lmpfr -lm

FROM ${RUNTIME_IMAGE}
COPY --from=builder /usr/local/bin/mini-boson-star-primary-c08-h2-function-profile-v4 /usr/local/bin/
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/mini-boson-star-primary-c08-h2-function-profile-v4"]
