COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_panel_defect_v1.hpp /src/
COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_panel_defect_v1.cpp /src/
COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_picard_v1.hpp /src/
COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_picard_v1.cpp /src/
COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_successor_panel_v1.hpp /src/
COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_successor_panel_v1.cpp /src/
COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_convolution_ledger_v1.hpp /src/
COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_convolution_ledger_v1.cpp /src/
COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_convolution_bivariate_v1.hpp /src/
COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_convolution_bivariate_v1.cpp /src/
COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_convolution_jet_v1.hpp /src/
COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_convolution_jet_v1.cpp /src/
COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_tail_split_chronology_v1.hpp /src/
COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_tail_lyapunov_v1.hpp /src/
COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_primary_c08_finite_history_v1.hpp /src/
COPY tools/nhm2-spherical-boson-star-v2-branch-proof/g2h/mini_boson_star_sha256_v1.hpp /src/
