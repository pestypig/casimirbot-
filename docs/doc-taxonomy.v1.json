      "reason": "Architecture decision records for active engineering context."
    },
    {
      "path": "docs/agents",
      "docClass": "current-development",
      "reason": "Agent-facing implementation and operations notes."
    },
    {
      "path": "docs/architecture",
      "docClass": "current-development",
      "reason": "Architecture notes and contracts for the active codebase."
    },
    {
      "path": "docs/development",
      "docClass": "current-development",
      "reason": "Current development notes promoted from the docs audit."
    },
    {
      "path": "docs/ethos",
      "docClass": "current-development",
      "reason": "Active ethos and ideology contract material."
    },
    {
      "path": "docs/experiments",
      "docClass": "current-development",
      "reason": "Experiment notes that support active implementation decisions."
    },
    {
      "path": "docs/helix-ask",
      "docClass": "current-development",
