{
  "schema": "casimirbot.docs_taxonomy.v1",
  "classes": {
    "canonical-research": {
      "description": "Maintained paper or research memo with citations, equations, claim boundaries, sidecars, or explicit artifact provenance.",
      "defaultFolder": "docs/research"
    },
    "current-development": {
      "description": "Still-valid implementation guidance, active contract, runbook, architecture note, or engineering plan.",
      "defaultFolder": "docs/development"
    },
    "synthetic-research": {
      "description": "Generated research-style material, prompt output, exploratory sweep, or speculative memo useful as synthetic data.",
      "defaultFolder": "docs/synthetic-research"
    },
    "legacy-development": {
      "description": "Historical or superseded implementation note, old patch plan, failed approach, stale checkpoint, or outdated roadmap.",
      "defaultFolder": "docs/legacy-development"
    }
  },
  "bundleKinds": {
    "equation-action-whitepaper": {
      "description": "Markdown whitepaper kept beside Calculator/equation-action sidecars.",
      "primaryFileExtension": ".md",
      "sidecarSuffixes": [
        ".equation-actions.json",
        ".equation-actions.source.json"
      ]
    }
  },
  "folderRules": [
    {
      "path": "docs/research",
      "docClass": "canonical-research",
      "reason": "Curated research papers and maintained research references."
    },
    {
      "path": "docs/papers",
      "docClass": "canonical-research",
      "reason": "Paper-oriented references that should sit with curated research."
    },
    {
      "path": "docs/audits/research",
      "docClass": "synthetic-research",
      "reason": "Generated or audit-style research packets useful as synthetic research data unless promoted explicitly."
    },
    {
      "path": "docs/knowledge",
      "docClass": "synthetic-research",
      "reason": "Generated knowledge-tree and evidence artifacts used as structured synthetic research context."
    },
    {
      "path": "docs/curvature-studies",
      "docClass": "synthetic-research",
      "reason": "Exploratory curvature-study outputs that are useful context but not promoted canonical papers."
    },
    {
      "path": "docs/moral-ladder-pack",
      "docClass": "synthetic-research",
      "reason": "Generated ladder-pack material used as synthetic knowledge data."
    },
    {
      "path": "docs/moral-society",
      "docClass": "synthetic-research",
      "reason": "Generated society/template material used as synthetic knowledge data."
    },
    {
