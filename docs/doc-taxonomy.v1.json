    {
      "path": "docs/renderer",
      "docClass": "current-development",
      "reason": "Renderer implementation notes."
    },
    {
      "path": "docs/runbooks",
      "docClass": "current-development",
      "reason": "Operational runbooks for active workflows."
    },
    {
      "path": "docs/specs",
      "docClass": "current-development",
      "reason": "Active specifications and contracts."
    },
    {
      "path": "docs/starsim",
      "docClass": "current-development",
      "reason": "Active StarSim implementation notes."
    },
    {
      "path": "docs/voice",
      "docClass": "current-development",
      "reason": "Active voice workflow documentation."
    },
    {
      "path": "docs/audits",
      "docClass": "legacy-development",
      "reason": "Historical audit and development trail retained for context unless a narrower rule promotes it."
    },
    {
      "path": "docs/legacy-development",
      "docClass": "legacy-development",
      "reason": "Explicit legacy development notes promoted from the docs audit."
    }
  ],
  "retrievalRules": [
    {
      "pathPrefix": "docs/research/nhm2-",
      "retrievalStatus": "archive",
      "topicId": "nhm2",
      "authorityRank": 10,
      "supersededBy": "docs/research/nhm2-current-status-whitepaper.md",
